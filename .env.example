# Copy to .env next to docker-compose.yml and fill in real values.
# Never commit the filled-in .env - it's gitignored.

# Panel admin credentials, set on the olcrtc-manager panel's first run.
OLCRTC_ROTATOR_PANEL_USER=admin
OLCRTC_ROTATOR_PANEL_PASS=changeme

# Fallback-only Google login, used if the persisted state.json session is
# ever rejected. Optional - omit all three if you don't want a fallback.
OLCRTC_ROTATOR_GOOGLE_EMAIL=
OLCRTC_ROTATOR_GOOGLE_PASSWORD=
OLCRTC_ROTATOR_GOOGLE_TOTP_SECRET=

# Telegram alert on rotation failure. From @BotFather / your chat id.
OLCRTC_ROTATOR_TELEGRAM_BOT_TOKEN=
OLCRTC_ROTATOR_TELEGRAM_CHAT_ID=

# Optional: separate login for the rotator's own web UI
# (https://olcrtc-rotator.<APP_DOMAIN>/). Leave both unset to reuse the
# panel admin user/pass above.
OLCRTC_ROTATOR_WEB_UI_USER=
OLCRTC_ROTATOR_WEB_UI_PASS=
